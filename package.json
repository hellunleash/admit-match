{
  "name": "admit-match",
  "version": "0.0.1",
  "private": true,
  "description": "Real-time eligibility matching for German MSc CS programs, with every requirement cited to its source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "extract": "tsx --env-file=.env src/cli/extract.ts",
    "traces": "tsx --env-file=.env src/cli/traces.ts",
    "modules": "tsx --env-file=.env src/cli/modules.ts"
  },
  "dependencies": {
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
