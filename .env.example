# Copy to .env and fill in. .env is gitignored and must stay that way.

# Extraction model. Gemini is used for its native PDF + German-language handling —
# statutes are frequently German PDFs, which is the normal case here, not an edge case.
GEMINI_API_KEY=

# Optional. Traces extraction calls (cost, latency, failures, prompt version).
# The app runs without these; tracing is simply disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional. Free hosted URL -> markdown. Falls back to raw fetch when unset.
JINA_API_KEY=
